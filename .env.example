# Copy to .env and fill in. .env is git-ignored.

# Only needed for live-Claude evals (`npm run eval`). The MCP server itself never reads it.
ANTHROPIC_API_KEY=

# Agent model for live evals (exact model ID). Override per run with `npm run eval -- --model <id>`.
CLAUDE_MODEL=claude-sonnet-5-5
# Reasoning effort for the eval agent loop: low | medium | high
CLAUDE_EFFORT=medium
# Server-side refusal fallback on supported models (Sonnet/Opus). Set to "off" to disable.
CLAUDE_FALLBACKS=on

# SQLite file used by the server. Relative paths resolve against the working directory;
# when unset, the server uses <repo>/data/shop.db.
# SHOPKEEPER_DB=./data/shop.db

# Pin the store clock (ISO 8601) so "late"/"overdue" calculations are reproducible.
# The seed data runs through 2026-09-29; evals and tests pin this value.
SHOPKEEPER_NOW=2026-09-30T18:00:00Z
