{
  "name": "shopkeeper-mcp",
  "version": "0.1.0",
  "description": "MCP server that lets Claude run a small online store (orders, refunds, invoices, reports, inventory) with guardrails, idempotent writes, and a deterministic eval harness.",
  "author": "Shubham Garje",
  "license": "MIT",
  "private": true,
  "type": "module",
  "bin": {
    "shopkeeper-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "anthropic",
    "agents",
    "evals",
    "sqlite"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.check.json",
    "start": "node dist/index.js",
    "start:http": "node dist/http.js",
    "dev": "tsx src/index.ts",
    "seed": "tsx src/db/seed-cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "tsx scripts/smoke.ts",
    "inspect": "npx -y @modelcontextprotocol/inspector -e SHOPKEEPER_NOW=2026-09-30T18:00:00Z node dist/index.js",
    "eval": "tsx evals/run.ts --mode live",
    "eval:oracle": "tsx evals/run.ts --mode oracle",
    "eval:baseline": "tsx evals/run.ts --mode baseline",
    "eval:report": "tsx evals/run.ts --report-only"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@types/node": "^26.6.5",
    "dotenv": "^18.0.9",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
